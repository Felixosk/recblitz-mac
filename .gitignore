# Build output (regenerated by build.sh)
.build/
.swiftpm/
dist/

# macOS cruft
.DS_Store
__pycache__/

# Generated icon artifacts
design/AppIcon.iconset/

# Local signing configuration (certificate name + fingerprint)
signing.local

# Never commit secrets or personal config. RecBlitz keeps its config in
# ~/Library/Application Support/RecBlitz/, this is a guard against a copy.
config.json
*secret*.json
